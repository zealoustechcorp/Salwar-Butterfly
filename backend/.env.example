# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# Loaded via `node --env-file=.env` (see package.json scripts)
# and validated in src/config/env.js.
# Never commit the real .env file.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

# One of: development | test | production   (default: development)
NODE_ENV=development

# Port between 1 and 65535                  (default: 4000)
PORT=4000


# ============================================================
# DATABASE  (required)
# ============================================================

# PostgreSQL connection string (sslmode=require)
# Neon console -> Connect -> pick the pooled connection (host contains
# "-pooler") for the app. Migrations are best run against the direct one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# OPTIONAL. Leave unset for Neon: its certificate is issued by a public CA
# and is verified against Node's built-in roots.
# Set it only for a provider that signs with its own private CA (e.g. Aiven:
# the PostgreSQL service -> Overview -> CA Certificate). PEM contents, not a
# path. Paste the whole file inside double quotes, line breaks and all. Hosts
# that only take single-line values can use literal \n between the lines.
# PG_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"


# ============================================================
# SESSIONS  (JWT_SECRET required)
# ============================================================

# Signs both halves of a session. Must be at least 32 characters long.
# Changing it signs out every admin and every shopper at once.
JWT_SECRET=replace_with_a_random_string_of_32_chars_or_more


# ============================================================
# TOKEN LIFETIMES
# ============================================================

# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d



# ============================================================
# CLOUDFLARE R2  (all required — image storage + CDN)
# ============================================================
# Cloudflare dashboard -> R2 Object Storage.
# Account id: the part before .r2.cloudflarestorage.com in the S3 API URL.
# Keys: Manage API tokens -> Create API token, "Object Read & Write",
# scoped to this bucket. The secret is shown once.
# Public URL: the custom domain connected to the bucket (Bucket ->
# Settings -> Custom Domains), not the S3 API URL and not r2.dev.

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=salwar-butterfly-images
R2_PUBLIC_URL=https://images.salwarbutterfly.in


# ============================================================
# RAZORPAY  (F-10 — optional)
# ============================================================

# Empty = online payment off. Webhook URL: /api/payments/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ============================================================
# CORS
# ============================================================

# Frontend origin allowed by CORS.
# Defaults to http://localhost:3000 outside production.
# Required (non-empty) when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000


# ============================================================
# SENTRY
# ============================================================

SENTRY_DSN=


# ============================================================
# REDIS  (optional)
# ============================================================
# Aiven console -> create a Valkey/Redis service -> Overview -> Service URI.
# It starts with rediss:// (double s = TLS). A local docker container
# gives you redis://localhost:6379 instead.
REDIS_URL=


# ============================================================
# WHATSAPP  (optional — Meta Cloud API)
# ============================================================
# Blank = notifications off, orders unaffected. First two are enough to send.
# System User token — the one in API Setup expires in 24h (error 190)
WHATSAPP_ACCESS_TOKEN=
# Numeric id of the sending number; it cannot also be in the WhatsApp app
WHATSAPP_PHONE_NUMBER_ID=
# Template status only, not sending
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Signs Meta's inbound receipts (App Settings -> Basic), not the access token
WHATSAPP_APP_SECRET=
# A string you invent, echoed back once during the webhook handshake
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# TESTING ONLY — redirects every message, customer and admin alike, to one
# number. Refuses to boot if set with NODE_ENV=production.
WHATSAPP_TEST_RECIPIENT=


# ============================================================
# EMAIL  (optional — Resend)
# ============================================================
# Blank key = order emails off (orders unaffected) and password reset off.
# Resend dashboard -> API Keys.
RESEND_API_KEY=
# Sender. Use onboarding@resend.dev until your domain is verified on Resend
# (Domains -> Add domain); until then Resend only delivers to the email
# address that owns the Resend account.
EMAIL_FROM=Salwar Butterfly <onboarding@resend.dev>
# Optional reply-to, e.g. the shop's support inbox.
EMAIL_REPLY_TO=
# Who is emailed about every new paid order. Comma-separated for several.
ADMIN_NOTIFY_EMAIL=
# The shop's public address, used for links in emails (password reset).
# Defaults to CORS_ORIGIN.
STOREFRONT_URL=http://localhost:3000
# Logo at the top of every email. Must be a public https URL (Gmail blocks
# embedded images). Defaults to <R2_PUBLIC_URL>/email/salwar-butterfly-logo.jpg.
# EMAIL_LOGO_URL=
# TESTING ONLY — redirects every email, customer and admin alike, to one
# address. Refuses to boot if set with NODE_ENV=production.
EMAIL_TEST_RECIPIENT=


# ============================================================
# LOGGING
# ============================================================

# winston log level: error | warn | info | http | verbose | debug | silly
# Defaults to "info" in production, "debug" otherwise.
# LOG_LEVEL=debug
