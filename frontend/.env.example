# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to `.env.local` and adjust if needed.
#   cp .env.example .env.local
#
# Only NEXT_PUBLIC_* variables reach the browser. Never put a
# secret in this file — everything here ships in the JS bundle.
# ============================================================

# Base URL of the Express API, including the /api prefix.
# The backend defaults to port 4000 (see backend/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
